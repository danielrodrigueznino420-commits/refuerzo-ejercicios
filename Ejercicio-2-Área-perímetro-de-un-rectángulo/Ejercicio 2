<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área y perímetro de un rectángulo</title>
</head>
<body>

    <h1>Área y perímetro de un rectángulo</h1>

    <div id="resultado"></div>

    <script>
        function calcularAreaPerimetro() {
            let base = parseFloat(prompt("Ingrese la base del rectángulo:"));
            let altura = parseFloat(prompt("Ingrese la altura del rectángulo:"));

            let area = base * altura;
            let perimetro = 2 * (base + altura);

            document.getElementById("resultado").innerHTML =
                "Área: " + area + "<br>" +
                "Perímetro: " + perimetro;
        }

        calcularAreaPerimetro();
    </script>
</body>
</html>